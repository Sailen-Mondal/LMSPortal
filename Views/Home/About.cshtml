@{
    ViewBag.Title = "About Us";
}

<section class="py-5 bg-white border-bottom">
    <div class="container py-4">
        <div class="row align-items-center gy-4">
            <div class="col-lg-6">
                <span class="text-primary text-uppercase fw-bold small tracking-wider">Our Mission</span>
                <h1 class="display-5 fw-bold text-dark mb-3">Democratizing World-Class Tech Education</h1>
                <p class="lead text-secondary fs-6 mb-4">
                    LMS Portal was engineered to bridge the gap between academic theory and real-world software production. We believe top-tier technical education in software architecture, cloud engineering, data science, and modern product design should be open, accessible, and self-paced.
                </p>
                <div class="row g-3 pt-2">
                    <div class="col-sm-6">
                        <div class="border rounded-3 p-3 bg-light">
                            <h3 class="fw-bold text-primary mb-1">100% Free</h3>
                            <p class="text-muted small mb-0">Open access for global learners without paywalls.</p>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="border rounded-3 p-3 bg-light">
                            <h3 class="fw-bold text-success mb-1">Self-Paced</h3>
                            <p class="text-muted small mb-0">Learn on your own schedule with verified progress tracking.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <img src="https://images.unsplash.com/photo-1531482615713-2afd69097998?w=800&auto=format&fit=crop&q=80" 
                     class="img-fluid rounded-4 shadow-lg w-100 object-fit-cover" 
                     alt="Students collaborating" 
                     style="max-height: 400px;" />
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-light">
    <div class="container py-4">
        <div class="text-center mb-5" style="max-width: 600px; margin: 0 auto;">
            <span class="text-primary text-uppercase fw-bold small">Our Core Pillars</span>
            <h2 class="fw-bold text-dark">Why Learn With LMS Portal?</h2>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 rounded-4 p-4 shadow-sm bg-white">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                        <i class="bi bi-cpu fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Production Engineering</h5>
                    <p class="text-muted small mb-0">We focus on clean architecture, resilient cloud deployments, and scalable patterns used by modern engineering teams.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 rounded-4 p-4 shadow-sm bg-white">
                    <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                        <i class="bi bi-check2-circle fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Accurate Progress Tracking</h5>
                    <p class="text-muted small mb-0">Our completion engine uses individual lesson milestones to maintain real-time status so you never lose your place.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 rounded-4 p-4 shadow-sm bg-white">
                    <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                        <i class="bi bi-people fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Curated By Industry Leads</h5>
                    <p class="text-muted small mb-0">Every lesson is crafted by seasoned engineers and designers with real production experience.</p>
                </div>
            </div>
        </div>
    </div>
</section>
