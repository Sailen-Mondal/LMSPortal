@using Microsoft.AspNet.Identity

@if (Request.IsAuthenticated)
{
    <ul class="navbar-nav ms-auto align-items-center">
        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item me-2">
                <a href="@Url.Action("Index", "AdminDashboard", new { area = "Admin" })" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center rounded-pill px-3 py-1 fw-semibold">
                    <i class="bi bi-shield-lock-fill me-1"></i> Admin Portal
                </a>
            </li>
        }
        else
        {
            <li class="nav-item me-2">
                <a href="@Url.Action("Dashboard", "Student", new { area = "" })" class="btn btn-sm btn-light border d-inline-flex align-items-center rounded-pill px-3 py-1 text-dark fw-semibold">
                    <i class="bi bi-speedometer2 me-1 text-primary"></i> My Learning
                </a>
            </li>
        }

        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center p-1" href="#" id="userMenuDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2 fw-bold shadow-sm" style="width: 36px; height: 36px; font-size: 14px;">
                    @(User.Identity.Name.Substring(0, 1).ToUpper())
                </div>
                <div class="d-none d-md-block text-start me-1">
                    <div class="fw-semibold text-dark lh-sm small">@User.Identity.Name</div>
                    <div class="text-muted lh-1" style="font-size: 11px;">
                        @(User.IsInRole("Admin") ? "Administrator" : "Student")
                    </div>
                </div>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 mt-2" aria-labelledby="userMenuDropdown">
                <li class="px-3 py-2 border-bottom bg-light bg-opacity-50">
                    <div class="fw-bold text-dark small">@User.Identity.Name</div>
                    <div class="text-muted" style="font-size: 11px;">
                        @(User.IsInRole("Admin") ? "Administrator" : "Active Student")
                    </div>
                </li>
                @if (User.IsInRole("Admin"))
                {
                    <li>
                        <a class="dropdown-item py-2 small" href="@Url.Action("Index", "AdminDashboard", new { area = "Admin" })">
                            <i class="bi bi-speedometer2 me-2 text-danger"></i> Admin Dashboard
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item py-2 small" href="@Url.Action("Index", "CourseManagement", new { area = "Admin" })">
                            <i class="bi bi-journal-album me-2 text-primary"></i> Manage Courses
                        </a>
                    </li>
                    <li><hr class="dropdown-divider my-1"></li>
                }
                <li>
                    <a class="dropdown-item py-2 small" href="@Url.Action("Dashboard", "Student", new { area = "" })">
                        <i class="bi bi-grid me-2 text-primary"></i> Student Dashboard
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-2 small" href="@Url.Action("MyCourses", "Student", new { area = "" })">
                        <i class="bi bi-book me-2 text-success"></i> My Enrolled Courses
                    </a>
                </li>
                <li><hr class="dropdown-divider my-1"></li>
                <li>
                    @using (Html.BeginForm("LogOff", "Account", new { area = "" }, FormMethod.Post, new { id = "logoutForm", @class = "m-0 p-0" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="dropdown-item py-2 small text-danger d-flex align-items-center w-100 border-0 bg-transparent text-start">
                            <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                        </button>
                    }
                </li>
            </ul>
        </li>
    </ul>
}
else
{
    <ul class="navbar-nav ms-auto align-items-center gap-2">
        <li class="nav-item">
            <a href="@Url.Action("Login", "Account", new { area = "" })" class="btn btn-outline-primary btn-sm px-3 rounded-pill fw-semibold">
                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
            </a>
        </li>
        <li class="nav-item">
            <a href="@Url.Action("Register", "Account", new { area = "" })" class="btn btn-primary btn-sm px-3 rounded-pill fw-semibold shadow-sm">
                Get Started
            </a>
        </li>
    </ul>
}
