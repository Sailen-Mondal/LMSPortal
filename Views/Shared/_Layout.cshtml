<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - LMS Portal</title>
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light border-bottom bg-white shadow-sm py-2">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center me-4" href="@Url.Action("Index", "Home")">
                    <div class="bg-primary text-white rounded-3 d-flex align-items-center justify-content-center me-2" style="width: 36px; height: 36px;">
                        <i class="bi bi-mortarboard-fill fs-5"></i>
                    </div>
                    <span class="fs-4 fw-bold text-dark">LMS<span class="text-primary">Portal</span></span>
                </a>
                
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Home")"><i class="bi bi-house me-1"></i> Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Course")"><i class="bi bi-collection-play me-1"></i> Browse Courses</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("About", "Home")">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Contact", "Home")">Contact</a>
                        </li>
                    </ul>

                    @Html.Partial("_LoginPartial")
                </div>
            </div>
        </nav>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    <main class="body-content">
        @RenderBody()
    </main>

    <footer class="bg-white border-top py-4 mt-5">
        <div class="container">
            <div class="row align-items-center justify-content-between gy-3">
                <div class="col-md-6 text-center text-md-start">
                    <div class="d-flex align-items-center justify-content-center justify-content-md-start mb-1">
                        <i class="bi bi-mortarboard-fill text-primary me-2"></i>
                        <span class="fw-bold text-dark">LMSPortal</span>
                    </div>
                    <p class="text-muted small mb-0">&copy; @DateTime.Now.Year LMS Portal. Production-Quality Educational Platform. All rights reserved.</p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <ul class="list-inline mb-0 small text-muted">
                        <li class="list-inline-item me-3"><a href="@Url.Action("Index", "Course")" class="text-muted text-decoration-none">Courses</a></li>
                        <li class="list-inline-item me-3"><a href="@Url.Action("About", "Home")" class="text-muted text-decoration-none">About</a></li>
                        <li class="list-inline-item"><a href="@Url.Action("Contact", "Home")" class="text-muted text-decoration-none">Contact</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
