@model LMSPortal.ViewModels.CourseDetailsViewModel
@{
    ViewBag.Title = Model.Course.Title;
}

<!-- Course Header Hero -->
<section class="bg-dark text-white py-5 position-relative">
    <div class="container py-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-3 small">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")" class="text-white text-opacity-75 text-decoration-none">Home</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Course")" class="text-white text-opacity-75 text-decoration-none">Courses</a></li>
                <li class="breadcrumb-item text-white text-opacity-50">@Model.Course.Category.Name</li>
                <li class="breadcrumb-item active text-white" aria-current="page">@Model.Course.Title</li>
            </ol>
        </nav>

        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge bg-primary px-3 py-1.5 rounded-pill small fw-semibold">
                        <i class="bi @Model.Course.Category.IconClass me-1"></i> @Model.Course.Category.Name
                    </span>
                    <span class="badge bg-secondary bg-opacity-50 px-2.5 py-1.5 rounded-pill small">
                        @Model.Course.Level
                    </span>
                    @if (Model.Course.IsFeatured)
                    {
                        <span class="badge bg-warning text-dark px-2.5 py-1.5 rounded-pill small fw-semibold">
                            <i class="bi bi-star-fill me-1"></i> Featured
                        </span>
                    }
                </div>

                <h1 class="display-6 fw-bold mb-3 text-white">@Model.Course.Title</h1>
                <p class="lead text-white text-opacity-75 fs-6 mb-4" style="max-width: 720px;">
                    @Model.Course.ShortDescription
                </p>

                <!-- Instructor & Meta Row -->
                <div class="d-flex flex-wrap align-items-center gap-4 text-white text-opacity-75 small">
                    <div class="d-flex align-items-center">
                        <img src="@Model.Course.InstructorAvatarUrl" 
                             alt="@Model.Course.InstructorName" 
                             class="rounded-circle me-2 object-fit-cover" 
                             style="width: 40px; height: 40px;"
                             onerror="this.src='https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80'">
                        <div>
                            <div class="text-white fw-semibold">@Model.Course.InstructorName</div>
                            <small class="text-white text-opacity-50" style="font-size: 11px;">@Model.Course.InstructorTitle</small>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <i class="bi bi-clock me-1 text-primary"></i>
                        <span>@(Model.Course.DurationMinutes / 60)h @(Model.Course.DurationMinutes % 60)m Total</span>
                    </div>
                    <div class="d-flex align-items-center">
                        <i class="bi bi-collection-play me-1 text-success"></i>
                        <span>@Model.TotalLessons Lessons</span>
                    </div>
                    <div class="d-flex align-items-center">
                        <i class="bi bi-calendar3 me-1 text-info"></i>
                        <span>Updated @Model.Course.CreatedDate.ToString("MMM yyyy")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Course Body & Sticky Sidebar -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row g-4 g-lg-5">
            <!-- Left Column: Curriculum & Details -->
            <div class="col-lg-8">
                <!-- What You'll Learn -->
                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-4 bg-white">
                    <h4 class="fw-bold text-dark mb-3">About This Course</h4>
                    <p class="text-secondary lh-lg mb-4">
                        @(string.IsNullOrEmpty(Model.Course.FullDescription) ? Model.Course.ShortDescription : Model.Course.FullDescription)
                    </p>

                    <h5 class="fw-bold text-dark mb-3">What You Will Master</h5>
                    <div class="row g-3">
                        <div class="col-md-6 d-flex align-items-start">
                            <i class="bi bi-check-circle-fill text-success fs-5 me-2 flex-shrink-0"></i>
                            <span class="text-secondary small">Comprehensive end-to-end understanding of foundational and advanced concepts.</span>
                        </div>
                        <div class="col-md-6 d-flex align-items-start">
                            <i class="bi bi-check-circle-fill text-success fs-5 me-2 flex-shrink-0"></i>
                            <span class="text-secondary small">Hands-on practical code implementation with real-world architectural patterns.</span>
                        </div>
                        <div class="col-md-6 d-flex align-items-start">
                            <i class="bi bi-check-circle-fill text-success fs-5 me-2 flex-shrink-0"></i>
                            <span class="text-secondary small">Industry standard best practices, clean code conventions, and performance optimization.</span>
                        </div>
                        <div class="col-md-6 d-flex align-items-start">
                            <i class="bi bi-check-circle-fill text-success fs-5 me-2 flex-shrink-0"></i>
                            <span class="text-secondary small">Lifelong self-paced access to study materials, references, and video walkthroughs.</span>
                        </div>
                    </div>
                </div>

                <!-- Curriculum Accordion -->
                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-4 bg-white">
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4">
                        <div>
                            <h4 class="fw-bold text-dark mb-1">Course Curriculum</h4>
                            <p class="text-muted small mb-0">@Model.Course.Modules.Count Modules &bull; @Model.TotalLessons Lessons</p>
                        </div>
                        @if (Model.FirstPreviewLesson != null)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 mt-2 mt-sm-0" data-bs-toggle="modal" data-bs-target="#previewModal">
                                <i class="bi bi-play-circle me-1"></i> Watch Free Preview
                            </button>
                        }
                    </div>

                    <div class="accordion" id="curriculumAccordion">
                        @{
                            int modIndex = 0;
                        }
                        @foreach (var module in Model.Course.Modules.OrderBy(m => m.OrderIndex))
                        {
                            string collapseId = "collapseMod_" + module.Id;
                            bool isFirst = modIndex == 0;
                            modIndex++;

                            <div class="accordion-item border rounded-3 mb-3 overflow-hidden shadow-none">
                                <h2 class="accordion-header" id="heading_@module.Id">
                                    <button class="accordion-button @(isFirst ? "" : "collapsed") fw-semibold bg-light text-dark py-3" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(isFirst ? "true" : "false")" aria-controls="@collapseId">
                                        <div class="d-flex justify-content-between align-items-center w-100 me-3">
                                            <span>@module.Title</span>
                                            <span class="badge bg-white text-muted border rounded-pill small fw-normal">
                                                @module.Lessons.Count Lessons
                                            </span>
                                        </div>
                                    </button>
                                </h2>
                                <div id="@collapseId" class="accordion-collapse collapse @(isFirst ? "show" : "")" aria-labelledby="heading_@module.Id" data-bs-parent="#curriculumAccordion">
                                    <div class="accordion-body p-0">
                                        @if (!string.IsNullOrEmpty(module.Description))
                                        {
                                            <div class="px-4 py-2 bg-light bg-opacity-50 text-muted small border-bottom fst-italic">
                                                @module.Description
                                            </div>
                                        }
                                        <ul class="list-group list-group-flush">
                                            @foreach (var lesson in module.Lessons.OrderBy(l => l.OrderIndex))
                                            {
                                                <li class="list-group-item d-flex align-items-center justify-content-between py-3 px-4">
                                                    <div class="d-flex align-items-center">
                                                        @if (lesson.IsFreePreview)
                                                        {
                                                            <i class="bi bi-play-circle-fill text-primary fs-5 me-3"></i>
                                                        }
                                                        else if (Model.IsEnrolled)
                                                        {
                                                            <i class="bi bi-play-circle text-success fs-5 me-3"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-lock-fill text-muted fs-5 me-3"></i>
                                                        }
                                                        <div>
                                                            <div class="fw-semibold text-dark small">@lesson.Title</div>
                                                            <small class="text-muted" style="font-size: 11px;">@lesson.DurationMinutes min</small>
                                                        </div>
                                                    </div>
                                                    <div>
                                                        @if (lesson.IsFreePreview)
                                                        {
                                                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill small px-2 py-1">
                                                                Free Preview
                                                            </span>
                                                        }
                                                        else if (!Model.IsEnrolled)
                                                        {
                                                            <span class="badge bg-light text-muted border rounded-pill small px-2 py-1">
                                                                Enrolled Only
                                                            </span>
                                                        }
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Instructor Profile Card -->
                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                    <h4 class="fw-bold text-dark mb-4">Your Instructor</h4>
                    <div class="d-flex flex-column flex-sm-row align-items-sm-start gap-4">
                        <img src="@Model.Course.InstructorAvatarUrl" 
                             alt="@Model.Course.InstructorName" 
                             class="rounded-circle object-fit-cover shadow-sm flex-shrink-0" 
                             style="width: 80px; height: 80px;"
                             onerror="this.src='https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80'">
                        <div>
                            <h5 class="fw-bold text-dark mb-1">@Model.Course.InstructorName</h5>
                            <div class="text-primary fw-semibold small mb-2">@Model.Course.InstructorTitle</div>
                            <p class="text-secondary small mb-0 lh-base">
                                @(string.IsNullOrEmpty(Model.Course.InstructorBio) ? "Experienced educator and industry practitioner committed to delivering high-impact, hands-on learning." : Model.Course.InstructorBio)
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Sticky Action Card -->
            <div class="col-lg-4">
                <div class="card border-0 shadow rounded-4 overflow-hidden bg-white sticky-top" style="top: 90px; z-index: 10;">
                    <!-- Preview Image -->
                    <div class="position-relative overflow-hidden" style="height: 200px;">
                        <img src="@Model.Course.ThumbnailUrl" 
                             alt="@Model.Course.Title" 
                             class="w-100 h-100 object-fit-cover"
                             onerror="this.src='https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=600&auto=format&fit=crop&q=80'">
                        
                        @if (Model.FirstPreviewLesson != null)
                        {
                            <button type="button" class="btn btn-light rounded-circle shadow position-absolute top-50 start-50 translate-middle d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;" data-bs-toggle="modal" data-bs-target="#previewModal">
                                <i class="bi bi-play-fill fs-3 text-primary ms-1"></i>
                            </button>
                        }
                    </div>

                    <div class="card-body p-4">
                        <!-- Free Enrollment Header -->
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="fs-3 fw-bold text-dark">Free</span>
                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1.5 fw-semibold small">
                                Open Access
                            </span>
                        </div>

                        <!-- Action Button depending on Authentication & Enrollment State -->
                        <div class="mb-4">
                            @if (!Request.IsAuthenticated)
                            {
                                <a href="@Url.Action("Login", "Account", new { returnUrl = "/course/" + Model.Course.Slug })" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm rounded-3 py-3">
                                    Log In to Enroll for Free <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                                <div class="text-center mt-2">
                                    <small class="text-muted" style="font-size: 11px;">Instant free enrollment after signing in</small>
                                </div>
                            }
                            else if (!Model.IsEnrolled)
                            {
                                using (Html.BeginForm("Enroll", "Enrollment", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("courseId", Model.Course.Id)
                                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm rounded-3 py-3">
                                        Enroll for Free <i class="bi bi-check-circle-fill ms-1"></i>
                                    </button>
                                }
                                <div class="text-center mt-2">
                                    <small class="text-muted" style="font-size: 11px;">Clicking above confirms immediate enrollment</small>
                                </div>
                            }
                            else
                            {
                                <div class="bg-light rounded-3 p-3 mb-3 border">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-semibold text-dark small"><i class="bi bi-check2-circle text-success me-1"></i> You are enrolled</span>
                                        <span class="fw-bold text-primary small">@Model.StudentProgress% Complete</span>
                                    </div>
                                    <div class="progress" style="height: 6px;">
                                        <div class="progress-bar bg-success" role="progressbar" style="width: @(Model.StudentProgress)%;" aria-valuenow="@Model.StudentProgress" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                </div>

                                <a href="@Url.Action("Player", "Learning", new { courseId = Model.Course.Id, lessonId = Model.ResumeLessonId })" class="btn btn-success btn-lg w-100 fw-bold shadow-sm rounded-3 py-3">
                                    <i class="bi bi-play-circle-fill me-2"></i> Continue Learning
                                </a>
                            }
                        </div>

                        <!-- Course Inclusions List -->
                        <div class="border-top pt-3">
                            <h6 class="fw-bold text-dark small mb-3">This course includes:</h6>
                            <ul class="list-unstyled text-muted small mb-0 d-flex flex-column gap-2.5">
                                <li class="d-flex align-items-center">
                                    <i class="bi bi-camera-video text-primary me-2"></i>
                                    <span>@(Model.Course.DurationMinutes / 60) hours on-demand video</span>
                                </li>
                                <li class="d-flex align-items-center">
                                    <i class="bi bi-file-earmark-text text-primary me-2"></i>
                                    <span>@Model.TotalLessons structured lessons</span>
                                </li>
                                <li class="d-flex align-items-center">
                                    <i class="bi bi-laptop text-primary me-2"></i>
                                    <span>Access on mobile, tablet & desktop</span>
                                </li>
                                <li class="d-flex align-items-center">
                                    <i class="bi bi-infinity text-primary me-2"></i>
                                    <span>Full lifetime access</span>
                                </li>
                                <li class="d-flex align-items-center">
                                    <i class="bi bi-award text-primary me-2"></i>
                                    <span>Verified completion tracking</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Free Preview Modal -->
@if (Model.FirstPreviewLesson != null)
{
    <div class="modal fade" id="previewModal" tabindex="-1" aria-labelledby="previewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content rounded-4 border-0 overflow-hidden shadow-lg">
                <div class="modal-header bg-dark text-white border-0 py-3">
                    <h5 class="modal-title fw-bold" id="previewModalLabel">
                        <i class="bi bi-play-circle text-primary me-2"></i> Free Preview: @Model.FirstPreviewLesson.Title
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0 bg-black">
                    <div class="ratio ratio-16x9">
                        <iframe src="@Model.FirstPreviewLesson.VideoUrl" 
                                title="@Model.FirstPreviewLesson.Title" 
                                allowfullscreen 
                                class="border-0">
                        </iframe>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <span class="text-muted small">Like what you see? Enroll to access the complete curriculum.</span>
                        @if (!Model.IsEnrolled)
                        {
                            <a href="@(Request.IsAuthenticated ? "javascript:void(0)" : Url.Action("Login", "Account", new { returnUrl = "/course/" + Model.Course.Slug }))" 
                               class="btn btn-primary rounded-pill px-4 fw-semibold"
                               onclick="@(Request.IsAuthenticated ? "document.querySelector('form[action*=\"Enroll\"]').submit();" : "")">
                                Enroll Now (Free)
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
