@{
    ViewBag.Title = "Enrollment Confirmed";
    var course = ViewBag.Course as LMSPortal.Models.Course;
    int? firstLessonId = ViewBag.FirstLessonId as int?;
}

<section class="py-5 bg-gradient-primary-soft" style="background: linear-gradient(180deg, rgba(16, 185, 129, 0.08) 0%, rgba(248, 250, 252, 1) 100%);">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-12 col-md-9 col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white text-center">
                    <!-- Celebration Icon -->
                    <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-circle mb-4 mx-auto" style="width: 80px; height: 80px;">
                        <i class="bi bi-check-circle-fill display-4"></i>
                    </div>

                    <span class="badge bg-success bg-opacity-10 text-success px-3 py-1.5 rounded-pill small fw-semibold mx-auto mb-2">
                        Enrollment Confirmed
                    </span>
                    <h2 class="fw-bold text-dark mb-2">You're Ready to Start Learning!</h2>
                    <p class="text-muted small mb-4" style="max-width: 500px; margin: 0 auto;">
                        Your free enrollment has been successfully recorded. You now have unlimited, lifetime access to all lessons, quizzes, and learning materials.
                    </p>

                    @if (course != null)
                    {
                        <!-- Course Recap Card -->
                        <div class="card border rounded-3 p-3 bg-light text-start mb-4">
                            <div class="d-flex align-items-center">
                                <img src="@course.ThumbnailUrl" 
                                     alt="@course.Title" 
                                     class="rounded-3 me-3 object-fit-cover shadow-sm flex-shrink-0" 
                                     style="width: 72px; height: 72px;"
                                     onerror="this.src='https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=600&auto=format&fit=crop&q=80'">
                                <div class="flex-grow-1 overflow-hidden">
                                    <span class="badge bg-white text-primary border small mb-1">@course.Category.Name</span>
                                    <h6 class="fw-bold text-dark mb-1 text-truncate">@course.Title</h6>
                                    <div class="text-muted small">
                                        <i class="bi bi-person me-1"></i> @course.InstructorName &bull; 
                                        <i class="bi bi-clock me-1 ms-1"></i> @(course.DurationMinutes / 60)h @(course.DurationMinutes % 60)m
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-grid gap-2 mb-3">
                            @if (firstLessonId.HasValue)
                            {
                                <a href="@Url.Action("Player", "Learning", new { courseId = course.Id, lessonId = firstLessonId.Value })" class="btn btn-primary btn-lg rounded-3 fw-bold py-3 shadow-sm">
                                    Start Learning Now <i class="bi bi-play-circle-fill ms-1"></i>
                                </a>
                            }
                            else
                            {
                                <a href="@Url.Action("Player", "Learning", new { courseId = course.Id })" class="btn btn-primary btn-lg rounded-3 fw-bold py-3 shadow-sm">
                                    Start Learning Now <i class="bi bi-play-circle-fill ms-1"></i>
                                </a>
                            }
                            
                            <a href="@Url.Action("Dashboard", "Student")" class="btn btn-outline-secondary rounded-3 fw-semibold py-2">
                                Go to Student Dashboard
                            </a>
                        </div>
                    }

                    <div class="pt-3 border-top mt-3">
                        <a href="@Url.Action("Index", "Course")" class="text-decoration-none small text-muted">
                            <i class="bi bi-arrow-left me-1"></i> Browse More Courses
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
