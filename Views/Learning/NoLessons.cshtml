@model LMSPortal.Models.Course
@{
    ViewBag.Title = "Course Content Coming Soon - " + Model.Title;
}

<div class="container py-5 text-center">
    <div class="card border-0 shadow-sm rounded-4 p-5 mx-auto bg-white" style="max-width: 600px;">
        <div class="mb-4">
            <i class="bi bi-cone-striped text-warning" style="font-size: 4rem;"></i>
        </div>
        <h3 class="fw-bold text-dark mb-2">Curriculum Under Preparation</h3>
        <p class="text-muted mb-4">
            The instructor is currently preparing the lessons and media for <strong>@Model.Title</strong>. Please check back soon or browse other active courses.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a href="@Url.Action("Details", "Course", new { slug = Model.Slug })" class="btn btn-outline-secondary rounded-pill px-4">
                Course Details
            </a>
            <a href="@Url.Action("Dashboard", "Student")" class="btn btn-primary rounded-pill px-4">
                Student Dashboard
            </a>
        </div>
    </div>
</div>
