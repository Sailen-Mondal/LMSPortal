# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.cs text diff=csharp eol=crlf
*.cshtml text eol=crlf
*.config text eol=crlf
*.sln text eol=crlf
*.slnx text eol=crlf
*.csproj text eol=crlf
*.json text eol=crlf
*.js text eol=crlf
*.css text eol=crlf
*.html text eol=crlf
*.xml text eol=crlf
*.sql text eol=crlf
*.md text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.dll binary
*.exe binary
*.pdb binary
*.so binary
*.dylib binary
