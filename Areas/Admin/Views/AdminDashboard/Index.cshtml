@model LMSPortal.Areas.Admin.ViewModels.AdminDashboardViewModel
@{
    ViewBag.Title = "Administrator Dashboard";
}

<!-- Stat Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">Total Courses</span>
                <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-2" style="width: 40px; height: 40px; display:flex; align-items:center; justify-content:center;">
                    <i class="bi bi-journal-album fs-5"></i>
                </div>
            </div>
            <h3 class="display-6 fw-bold mb-0 text-dark">@Model.TotalCourses</h3>
            <small class="text-muted mt-1 d-block">@Model.PublishedCourses live, @Model.DraftCourses draft</small>
        </div>
    </div>

    <div class="col-sm-6 col-xl">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">Active Categories</span>
                <div class="bg-purple bg-opacity-10 text-primary rounded-3 p-2" style="background-color: rgba(114, 9, 183, 0.1); color: #7209b7 !important; width: 40px; height: 40px; display:flex; align-items:center; justify-content:center;">
                    <i class="bi bi-tags fs-5"></i>
                </div>
            </div>
            <h3 class="display-6 fw-bold mb-0 text-dark">@Model.TotalCategories</h3>
            <small class="text-muted mt-1 d-block">Domain taxonomy</small>
        </div>
    </div>

    <div class="col-sm-6 col-xl">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">Registered Students</span>
                <div class="bg-success bg-opacity-10 text-success rounded-3 p-2" style="width: 40px; height: 40px; display:flex; align-items:center; justify-content:center;">
                    <i class="bi bi-people fs-5"></i>
                </div>
            </div>
            <h3 class="display-6 fw-bold mb-0 text-dark">@Model.TotalStudents</h3>
            <small class="text-success mt-1 d-block"><i class="bi bi-person-check me-1"></i>Active accounts</small>
        </div>
    </div>

    <div class="col-sm-6 col-xl">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">Total Enrollments</span>
                <div class="bg-info bg-opacity-10 text-info rounded-3 p-2" style="width: 40px; height: 40px; display:flex; align-items:center; justify-content:center;">
                    <i class="bi bi-mortarboard fs-5"></i>
                </div>
            </div>
            <h3 class="display-6 fw-bold mb-0 text-dark">@Model.TotalEnrollments</h3>
            <small class="text-muted mt-1 d-block">Across all courses</small>
        </div>
    </div>

    <div class="col-sm-6 col-xl">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">Completed Courses</span>
                <div class="bg-warning bg-opacity-10 text-warning rounded-3 p-2" style="width: 40px; height: 40px; display:flex; align-items:center; justify-content:center;">
                    <i class="bi bi-award fs-5"></i>
                </div>
            </div>
            <h3 class="display-6 fw-bold mb-0 text-dark">@Model.TotalCompletions</h3>
            <small class="text-muted mt-1 d-block">100% completions</small>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Recent Courses Table -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-journal-album text-primary me-2"></i>Recent Courses</h6>
                <a href="@Url.Action("Index", "CourseManagement", new { area = "Admin" })" class="text-primary text-decoration-none small fw-semibold">
                    View All Courses <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Course</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Enrollments</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in Model.RecentCourses)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-bold text-dark">@course.Title</div>
                                    <small class="text-muted">By @course.InstructorName</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(course.Category != null ? course.Category.Name : "General")
                                    </span>
                                </td>
                                <td>
                                    @if (course.IsPublished)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success rounded-pill px-2 py-1">Published</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary rounded-pill px-2 py-1">Draft</span>
                                    }
                                </td>
                                <td>
                                    <span class="fw-semibold">@course.Enrollments.Count</span>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a href="@Url.Action("Index", "ModuleManagement", new { area = "Admin", courseId = course.Id })" class="btn btn-outline-primary" title="Curriculum / Modules">
                                            <i class="bi bi-list-task"></i>
                                        </a>
                                        <a href="@Url.Action("Edit", "CourseManagement", new { area = "Admin", id = course.Id })" class="btn btn-outline-secondary" title="Edit Course">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Recent Student Enrollments Table -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-mortarboard text-success me-2"></i>Recent Enrollments</h6>
                <a href="@Url.Action("Index", "StudentManagement", new { area = "Admin" })" class="text-primary text-decoration-none small fw-semibold">
                    View Students <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Student</th>
                                <th>Course</th>
                                <th class="text-end pe-3">Progress</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentEnrollments.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-4 text-muted">No enrollments recorded yet.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var enrollment in Model.RecentEnrollments)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <div class="fw-bold text-dark small">@enrollment.StudentName</div>
                                            <div class="text-muted" style="font-size: 11px;">@enrollment.StudentEmail</div>
                                        </td>
                                        <td>
                                            <div class="small text-truncate" style="max-width: 140px;" title="@enrollment.CourseTitle">
                                                @enrollment.CourseTitle
                                            </div>
                                            <small class="text-muted" style="font-size: 11px;">@enrollment.EnrolledDate.ToString("MMM dd, yyyy")</small>
                                        </td>
                                        <td class="text-end pe-3">
                                            <span class="badge @(enrollment.CompletionPercentage == 100 ? "bg-success" : "bg-primary") rounded-pill">
                                                @enrollment.CompletionPercentage%
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
