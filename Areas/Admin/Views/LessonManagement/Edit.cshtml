@model LMSPortal.Areas.Admin.ViewModels.LessonFormViewModel
@{
    ViewBag.Title = "Edit Lesson - " + Model.Title;
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <div>
                    <h4 class="fw-bold text-dark mb-1">Edit Lesson</h4>
                    <p class="text-muted mb-0">Module: <strong>@Model.ModuleTitle</strong> &bull; Course: <strong>@Model.CourseTitle</strong></p>
                </div>
                <a href="@Url.Action("Index", "ModuleManagement", new { area = "Admin", courseId = Model.CourseId })" class="btn btn-outline-secondary rounded-pill px-3">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
            </div>

            @using (Html.BeginForm("Edit", "LessonManagement", new { area = "Admin" }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                <div class="form-floating mb-3">
                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control rounded-3", placeholder = "Lesson Title", required = "required" })
                    @Html.LabelFor(m => m.Title)
                    @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            @Html.TextBoxFor(m => m.DurationMinutes, new { @class = "form-control rounded-3", type = "number", min = "1", placeholder = "10" })
                            @Html.LabelFor(m => m.DurationMinutes)
                            @Html.ValidationMessageFor(m => m.DurationMinutes, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            @Html.TextBoxFor(m => m.OrderIndex, new { @class = "form-control rounded-3", type = "number", placeholder = "1" })
                            @Html.LabelFor(m => m.OrderIndex)
                        </div>
                    </div>
                </div>

                <div class="form-floating mb-3">
                    @Html.TextBoxFor(m => m.VideoUrl, new { @class = "form-control rounded-3", placeholder = "https://www.youtube.com/watch?v=..." })
                    @Html.LabelFor(m => m.VideoUrl)
                    <small class="text-muted">Supports YouTube watch links, short links (youtu.be), or direct MP4/stream embeds.</small>
                </div>

                <div class="form-floating mb-3">
                    @Html.TextAreaFor(m => m.Content, new { @class = "form-control rounded-3", style = "height: 180px;", placeholder = "Lesson Content" })
                    @Html.LabelFor(m => m.Content)
                </div>

                <div class="form-check form-switch mb-4">
                    @Html.CheckBoxFor(m => m.IsFreePreview, new { @class = "form-check-input", role = "switch", id = "switchPreview" })
                    <label class="form-check-label fw-semibold" for="switchPreview">Free Preview Lesson (accessible to public without enrollment)</label>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a href="@Url.Action("Index", "ModuleManagement", new { area = "Admin", courseId = Model.CourseId })" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-semibold">Save Changes</button>
                </div>
            }
        </div>
    </div>
</div>
