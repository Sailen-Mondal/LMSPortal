@model IEnumerable<LMSPortal.Models.Course>
@{
    ViewBag.Title = "Course Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Course Catalog Management</h3>
        <p class="text-muted mb-0">Create, edit, organize curriculum, and publish courses.</p>
    </div>
    <div>
        <a href="@Url.Action("Create", "CourseManagement", new { area = "Admin" })" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-plus-lg me-1"></i> Add New Course
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Course</th>
                    <th>Category</th>
                    <th>Level</th>
                    <th>Curriculum</th>
                    <th>Enrollments</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-journal-x display-4 d-block mb-2"></i>
                            No courses created yet. Click "Add New Course" above.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var course in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@(string.IsNullOrEmpty(course.ThumbnailUrl) ? "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=100&auto=format&fit=crop&q=80" : course.ThumbnailUrl)" 
                                         class="rounded-3 object-fit-cover shadow-sm" 
                                         style="width: 52px; height: 52px;" 
                                         alt="@course.Title"
                                         onerror="this.src='https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=100&auto=format&fit=crop&q=80';" />
                                    <div>
                                        <div class="fw-bold text-dark">@course.Title</div>
                                        <small class="text-muted">Instructor: @course.InstructorName &bull; @course.DurationMinutes mins</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(course.Category != null ? course.Category.Name : "General")
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-info-subtle text-info border border-info rounded-pill px-2">
                                    @course.Level
                                </span>
                            </td>
                            <td>
                                <a href="@Url.Action("Index", "ModuleManagement", new { area = "Admin", courseId = course.Id })" class="text-primary text-decoration-none fw-semibold small">
                                    <i class="bi bi-diagram-3 me-1"></i>@course.Modules.Count modules
                                </a>
                            </td>
                            <td>
                                <span class="badge @(course.Enrollments.Count > 0 ? "bg-primary" : "bg-light text-muted border") rounded-pill px-2.5">
                                    @course.Enrollments.Count students
                                </span>
                            </td>
                            <td>
                                @if (course.IsPublished)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success rounded-pill px-2 py-1">
                                        <i class="bi bi-check-circle-fill me-1"></i> Published
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary rounded-pill px-2 py-1">
                                        <i class="bi bi-eye-slash-fill me-1"></i> Draft / Archived
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex align-items-center gap-1">
                                    <a href="@Url.Action("Index", "ModuleManagement", new { area = "Admin", courseId = course.Id })" class="btn btn-sm btn-outline-primary" title="Curriculum & Lessons">
                                        <i class="bi bi-list-task"></i>
                                    </a>
                                    <a href="@Url.Action("Edit", "CourseManagement", new { area = "Admin", id = course.Id })" class="btn btn-sm btn-outline-secondary" title="Edit Course Details">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    
                                    <!-- Toggle Publish Form -->
                                    @using (Html.BeginForm("TogglePublish", "CourseManagement", new { area = "Admin", id = course.Id }, FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(course.IsPublished ? "btn-outline-warning" : "btn-outline-success")" title="@(course.IsPublished ? "Unpublish Course (Archive)" : "Publish Course")">
                                            <i class="bi @(course.IsPublished ? "bi-eye-slash" : "bi-eye")"></i>
                                        </button>
                                    }

                                    <!-- Delete Course Form -->
                                    @using (Html.BeginForm("Delete", "CourseManagement", new { area = "Admin", id = course.Id }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Are you sure you want to delete this course? Courses with active student enrollments cannot be deleted and must be unpublished instead.');" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Course">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
