@model LMSPortal.Areas.Admin.ViewModels.CourseFormViewModel
@{
    ViewBag.Title = "Edit Course - " + Model.Title;
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <div>
                    <h4 class="fw-bold text-dark mb-1">Edit Course</h4>
                    <p class="text-muted mb-0">Update metadata and configuration for <strong>@Model.Title</strong>.</p>
                </div>
                <div class="d-flex gap-2">
                    <a href="@Url.Action("Index", "ModuleManagement", new { area = "Admin", courseId = Model.Id })" class="btn btn-outline-primary rounded-pill px-3">
                        <i class="bi bi-list-task me-1"></i> Manage Curriculum
                    </a>
                    <a href="@Url.Action("Index", "CourseManagement", new { area = "Admin" })" class="btn btn-outline-secondary rounded-pill px-3">
                        <i class="bi bi-arrow-left me-1"></i> Back to Catalog
                    </a>
                </div>
            </div>

            @using (Html.BeginForm("Edit", "CourseManagement", new { area = "Admin" }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                <div class="row g-3">
                    <div class="col-md-8">
                        <div class="form-floating mb-3">
                            @Html.TextBoxFor(m => m.Title, new { @class = "form-control rounded-3", placeholder = "Course Title", required = "required" })
                            @Html.LabelFor(m => m.Title)
                            @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating mb-3">
                            @Html.TextBoxFor(m => m.Slug, new { @class = "form-control rounded-3", placeholder = "url-slug", required = "required" })
                            @Html.LabelFor(m => m.Slug)
                            @Html.ValidationMessageFor(m => m.Slug, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating mb-3">
                            @Html.DropDownListFor(m => m.CategoryId, Model.Categories, "-- Select Category --", new { @class = "form-select rounded-3", required = "required" })
                            @Html.LabelFor(m => m.CategoryId)
                            @Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating mb-3">
                            @Html.EnumDropDownListFor(m => m.Level, new { @class = "form-select rounded-3" })
                            @Html.LabelFor(m => m.Level)
                            @Html.ValidationMessageFor(m => m.Level, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating mb-3">
                            @Html.TextBoxFor(m => m.DurationMinutes, new { @class = "form-control rounded-3", type = "number", min = "1", placeholder = "60" })
                            @Html.LabelFor(m => m.DurationMinutes)
                            @Html.ValidationMessageFor(m => m.DurationMinutes, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            @Html.TextBoxFor(m => m.InstructorName, new { @class = "form-control rounded-3", placeholder = "Instructor Name", required = "required" })
                            @Html.LabelFor(m => m.InstructorName)
                            @Html.ValidationMessageFor(m => m.InstructorName, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            @Html.TextBoxFor(m => m.ThumbnailUrl, new { @class = "form-control rounded-3", placeholder = "https://images.unsplash.com/..." })
                            @Html.LabelFor(m => m.ThumbnailUrl)
                            @Html.ValidationMessageFor(m => m.ThumbnailUrl, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="form-floating mb-3">
                            @Html.TextAreaFor(m => m.InstructorBio, new { @class = "form-control rounded-3", style = "height: 80px;", placeholder = "Instructor Bio" })
                            @Html.LabelFor(m => m.InstructorBio)
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="form-floating mb-3">
                            @Html.TextAreaFor(m => m.ShortDescription, new { @class = "form-control rounded-3", style = "height: 100px;", placeholder = "Short Description", required = "required" })
                            @Html.LabelFor(m => m.ShortDescription)
                            @Html.ValidationMessageFor(m => m.ShortDescription, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="form-floating mb-3">
                            @Html.TextAreaFor(m => m.FullDescription, new { @class = "form-control rounded-3", style = "height: 160px;", placeholder = "Full Description" })
                            @Html.LabelFor(m => m.FullDescription)
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch mb-4">
                            @Html.CheckBoxFor(m => m.IsPublished, new { @class = "form-check-input", role = "switch", id = "switchPublish" })
                            <label class="form-check-label fw-semibold" for="switchPublish">Published (live in public catalog)</label>
                        </div>
                    </div>

                    <div class="col-12 pt-3 border-top d-flex justify-content-end gap-2">
                        <a href="@Url.Action("Index", "CourseManagement", new { area = "Admin" })" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 fw-semibold shadow-sm">Save Changes</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
