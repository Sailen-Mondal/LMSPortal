<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - LMS Admin Portal</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Site.css")" rel="stylesheet" />
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }
        .admin-sidebar {
            width: 260px;
            min-height: 100vh;
            background-color: #0f172a;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
        }
        .admin-sidebar .nav-link {
            color: #94a3b8;
            padding: 12px 20px;
            border-radius: 10px;
            margin: 4px 12px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: all 0.2s ease;
        }
        .admin-sidebar .nav-link:hover, .admin-sidebar .nav-link.active {
            color: #ffffff;
            background-color: #1e293b;
        }
        .admin-sidebar .nav-link.active {
            background-color: #4361ee;
            color: #ffffff;
        }
        .admin-main {
            margin-left: 260px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .admin-topbar {
            height: 70px;
            background-color: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            padding: 0 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 999;
        }
        @@media (max-width: 992px) {
            .admin-sidebar {
                margin-left: -260px;
                transition: margin 0.3s ease;
            }
            .admin-sidebar.show {
                margin-left: 0;
            }
            .admin-main {
                margin-left: 0;
            }
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <aside class="admin-sidebar d-flex flex-column">
        <div class="p-4 border-bottom border-secondary border-opacity-25">
            <a href="@Url.Action("Index", "AdminDashboard", new { area = "Admin" })" class="text-white text-decoration-none d-flex align-items-center gap-2">
                <div class="bg-primary text-white rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                    <i class="bi bi-mortarboard-fill fs-5"></i>
                </div>
                <div>
                    <span class="fs-5 fw-bold text-white">LMS Portal</span>
                    <span class="badge bg-danger rounded-pill ms-1" style="font-size: 10px;">Admin</span>
                </div>
            </a>
        </div>

        <div class="py-3 flex-grow-1">
            <div class="px-4 text-white-50 text-uppercase small fw-bold mb-2" style="font-size: 11px;">Management</div>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "AdminDashboard" ? "active" : "")" href="@Url.Action("Index", "AdminDashboard", new { area = "Admin" })">
                        <i class="bi bi-speedometer2 fs-5"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "CourseManagement" || ViewContext.RouteData.Values["controller"].ToString() == "ModuleManagement" || ViewContext.RouteData.Values["controller"].ToString() == "LessonManagement" ? "active" : "")" href="@Url.Action("Index", "CourseManagement", new { area = "Admin" })">
                        <i class="bi bi-journal-album fs-5"></i> Courses
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "CategoryManagement" ? "active" : "")" href="@Url.Action("Index", "CategoryManagement", new { area = "Admin" })">
                        <i class="bi bi-tags fs-5"></i> Categories
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "StudentManagement" ? "active" : "")" href="@Url.Action("Index", "StudentManagement", new { area = "Admin" })">
                        <i class="bi bi-people fs-5"></i> Students
                    </a>
                </li>
            </ul>

            <div class="px-4 text-white-50 text-uppercase small fw-bold mt-4 mb-2" style="font-size: 11px;">Quick Links</div>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Course", new { area = "" })" target="_blank">
                        <i class="bi bi-box-arrow-up-right fs-5"></i> View Public Catalog
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Dashboard", "Student", new { area = "" })">
                        <i class="bi bi-person-workspace fs-5"></i> Student View
                    </a>
                </li>
            </ul>
        </div>

        <div class="p-3 border-top border-secondary border-opacity-25">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px;">
                        A
                    </div>
                    <div>
                        <div class="text-white small fw-bold">Admin</div>
                        <div class="text-white-50" style="font-size: 11px;">@User.Identity.Name</div>
                    </div>
                </div>
                <div>
                    @using (Html.BeginForm("LogOff", "Account", new { area = "" }, FormMethod.Post, new { id = "adminLogoutForm" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-light btn-sm rounded-circle p-2" title="Sign Out">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    }
                </div>
            </div>
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="admin-main">
        <!-- Topbar -->
        <header class="admin-topbar">
            <div>
                <h5 class="fw-bold mb-0 text-dark">@ViewBag.Title</h5>
            </div>
            <div class="d-flex align-items-center gap-3">
                <a href="@Url.Action("Create", "CourseManagement", new { area = "Admin" })" class="btn btn-primary btn-sm rounded-pill px-3">
                    <i class="bi bi-plus-lg me-1"></i> New Course
                </a>
                <a href="@Url.Action("Index", "Home", new { area = "" })" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-globe me-1"></i> Storefront
                </a>
            </div>
        </header>

        <!-- Alerts & Page Content -->
        <main class="p-4 flex-grow-1">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill fs-5"></i>
                        <div>@TempData["SuccessMessage"]</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-octagon-fill fs-5"></i>
                        <div><strong>Attention:</strong> @TempData["ErrorMessage"]</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </main>

        <footer class="p-4 bg-white border-top text-center text-muted small">
            &copy; @DateTime.UtcNow.Year LMS Portal Administration. Production-Grade Learning Platform.
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
