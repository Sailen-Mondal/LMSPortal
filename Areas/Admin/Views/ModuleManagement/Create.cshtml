@model LMSPortal.Areas.Admin.ViewModels.ModuleFormViewModel
@{
    ViewBag.Title = "Add Module - " + Model.CourseTitle;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <div>
                    <h4 class="fw-bold text-dark mb-1">Add Curriculum Module</h4>
                    <p class="text-muted mb-0">For course: <strong>@Model.CourseTitle</strong></p>
                </div>
                <a href="@Url.Action("Index", "ModuleManagement", new { area = "Admin", courseId = Model.CourseId })" class="btn btn-outline-secondary rounded-pill px-3">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
            </div>

            @using (Html.BeginForm("Create", "ModuleManagement", new { area = "Admin" }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.CourseId)
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                <div class="form-floating mb-3">
                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control rounded-3", placeholder = "Module Title", required = "required" })
                    @Html.LabelFor(m => m.Title)
                    @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
                </div>

                <div class="form-floating mb-3">
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control rounded-3", style = "height: 100px;", placeholder = "Description" })
                    @Html.LabelFor(m => m.Description)
                </div>

                <div class="form-floating mb-4">
                    @Html.TextBoxFor(m => m.OrderIndex, new { @class = "form-control rounded-3", type = "number", placeholder = "1" })
                    @Html.LabelFor(m => m.OrderIndex)
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a href="@Url.Action("Index", "ModuleManagement", new { area = "Admin", courseId = Model.CourseId })" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-semibold">Save Module</button>
                </div>
            }
        </div>
    </div>
</div>
