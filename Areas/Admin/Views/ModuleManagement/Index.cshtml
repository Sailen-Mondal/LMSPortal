@model LMSPortal.Models.Course
@{
    ViewBag.Title = "Curriculum Management - " + Model.Title;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a href="@Url.Action("Index", "CourseManagement", new { area = "Admin" })" class="text-muted text-decoration-none small">
                <i class="bi bi-arrow-left"></i> Courses
            </a>
            <span class="text-muted small">&bull;</span>
            <span class="badge bg-primary rounded-pill">Curriculum Builder</span>
        </div>
        <h3 class="fw-bold text-dark mb-0">@Model.Title</h3>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Create", "ModuleManagement", new { area = "Admin", courseId = Model.Id })" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-folder-plus me-1"></i> Add Module
        </a>
        <a href="@Url.Action("Player", "Learning", new { area = "", courseId = Model.Id })" class="btn btn-outline-secondary rounded-pill px-3" target="_blank">
            <i class="bi bi-play-circle me-1"></i> Preview Player
        </a>
    </div>
</div>

@if (!Model.Modules.Any())
{
    <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-4 bg-white">
        <div class="mb-3">
            <i class="bi bi-folder2-open text-muted" style="font-size: 3.5rem;"></i>
        </div>
        <h5 class="fw-bold text-dark">No modules created yet</h5>
        <p class="text-muted mx-auto mb-4" style="max-width: 480px;">
            A course requires modules to organize lectures, quizzes, and learning materials.
        </p>
        <div>
            <a href="@Url.Action("Create", "ModuleManagement", new { area = "Admin", courseId = Model.Id })" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-folder-plus me-1"></i> Create First Module
            </a>
        </div>
    </div>
}
else
{
    var sortedModules = Model.Modules.OrderBy(m => m.OrderIndex).ToList();
    for (int i = 0; i < sortedModules.Count; i++)
    {
        var module = sortedModules[i];
        var sortedLessons = module.Lessons.OrderBy(l => l.OrderIndex).ToList();
        
        <div class="card border-0 shadow-sm rounded-4 bg-white mb-4 overflow-hidden">
            <div class="card-header bg-light p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-dark rounded-pill px-3 py-1">Module @(i + 1)</span>
                    <h5 class="fw-bold text-dark mb-0">@module.Title</h5>
                    <span class="text-muted small">(@sortedLessons.Count lessons)</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a href="@Url.Action("Create", "LessonManagement", new { area = "Admin", moduleId = module.Id })" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                        <i class="bi bi-plus-circle me-1"></i> Add Lesson
                    </a>
                    <a href="@Url.Action("Edit", "ModuleManagement", new { area = "Admin", id = module.Id })" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                    @using (Html.BeginForm("Delete", "ModuleManagement", new { area = "Admin", id = module.Id }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Are you sure you want to delete this module and ALL its lessons?');" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2" title="Delete Module">
                            <i class="bi bi-trash"></i>
                        </button>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(module.Description))
            {
                <div class="px-4 py-2 bg-light bg-opacity-50 text-muted small border-bottom">
                    @module.Description
                </div>
            }

            <div class="card-body p-0">
                @if (!sortedLessons.Any())
                {
                    <div class="text-center py-4 text-muted small">
                        No lessons added to this module yet. Click "Add Lesson" above.
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var lesson in sortedLessons)
                        {
                            <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center px-4 py-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 13px; font-weight: bold;">
                                        @lesson.OrderIndex
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">
                                            @lesson.Title
                                            @if (lesson.IsFreePreview)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success rounded-pill ms-2" style="font-size: 10px;">Free Preview</span>
                                            }
                                        </div>
                                        <small class="text-muted">
                                            <i class="bi bi-clock me-1"></i>@lesson.DurationMinutes mins
                                            @if (!string.IsNullOrEmpty(lesson.VideoUrl))
                                            {
                                                <span class="ms-2"><i class="bi bi-play-btn me-1"></i>Video Attached</span>
                                            }
                                        </small>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2 mt-2 mt-sm-0">
                                    <a href="@Url.Action("Edit", "LessonManagement", new { area = "Admin", id = lesson.Id })" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @using (Html.BeginForm("Delete", "LessonManagement", new { area = "Admin", id = lesson.Id }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Are you sure you want to delete this lesson?');" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Lesson">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    }
}
