@model LMSPortal.Models.ApplicationUser
@{
    ViewBag.Title = "Student History - " + (Model.FullName ?? Model.UserName);
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <a href="@Url.Action("Index", "StudentManagement", new { area = "Admin" })" class="text-muted text-decoration-none small">
                    <i class="bi bi-arrow-left"></i> Students
                </a>
                <h3 class="fw-bold text-dark mb-0">@(Model.FullName ?? Model.UserName)</h3>
                <small class="text-muted">@Model.Email &bull; Member since @Model.CreatedDate.ToString("MMMM dd, yyyy")</small>
            </div>
            <a href="@Url.Action("Index", "StudentManagement", new { area = "Admin" })" class="btn btn-outline-secondary rounded-pill px-3">
                Back to List
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-4">
            <div class="card-header bg-white border-bottom p-3">
                <h5 class="fw-bold text-dark mb-0">Enrolled Courses & Learning Progress</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Course</th>
                            <th>Enrolled Date</th>
                            <th>Last Accessed</th>
                            <th>Progress</th>
                            <th class="text-end pe-4">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Enrollments.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No course enrollments for this student yet.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var e in Model.Enrollments)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@(e.Course != null ? e.Course.Title : "Unknown Course")</div>
                                        <small class="text-muted">Instructor: @(e.Course != null ? e.Course.InstructorName : "N/A")</small>
                                    </td>
                                    <td class="small text-muted">@e.EnrolledDate.ToString("MMM dd, yyyy")</td>
                                    <td class="small text-muted">@(e.LastAccessedDate.HasValue ? e.LastAccessedDate.Value.ToString("MMM dd, yyyy") : "Never")</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height: 6px; width: 100px;">
                                                <div class="progress-bar @(e.CompletionPercentage == 100 ? "bg-success" : "bg-primary")" style="width: @(e.CompletionPercentage)%;"></div>
                                            </div>
                                            <span class="small fw-bold">@e.CompletionPercentage%</span>
                                        </div>
                                    </td>
                                    <td class="text-end pe-4">
                                        <span class="badge @(e.Status == LMSPortal.Models.EnrollmentStatus.Completed ? "bg-success" : "bg-primary") rounded-pill">
                                            @e.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
