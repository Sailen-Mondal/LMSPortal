@model IEnumerable<LMSPortal.Areas.Admin.ViewModels.AdminStudentItemViewModel>
@{
    ViewBag.Title = "Student Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Registered Students</h3>
        <p class="text-muted mb-0">View all students, their total course enrollments, and completion progress.</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Student</th>
                    <th>Email Address</th>
                    <th>Joined Date</th>
                    <th>Enrolled Courses</th>
                    <th>Completed Courses</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-people display-4 d-block mb-2"></i>
                            No registered students found yet.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var student in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
                                        @(string.IsNullOrEmpty(student.FullName) ? "S" : student.FullName.Substring(0, 1).ToUpper())
                                    </div>
                                    <div class="fw-bold text-dark">@student.FullName</div>
                                </div>
                            </td>
                            <td>@student.Email</td>
                            <td class="text-muted small">@student.CreatedDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1">
                                    @student.EnrollmentCount courses
                                </span>
                            </td>
                            <td>
                                <span class="badge @(student.CompletedCoursesCount > 0 ? "bg-success" : "bg-light text-muted border") rounded-pill px-3 py-1">
                                    @student.CompletedCoursesCount completed
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <a href="@Url.Action("Details", "StudentManagement", new { area = "Admin", id = student.Id })" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="bi bi-eye me-1"></i> View History
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
